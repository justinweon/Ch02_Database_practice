# ==========================================
# 환경 변수 템플릿 파일 (.env.example)
# 실제 .env 파일은 비밀이므로 깃허브에 올리지 않고,
# 채점관이 코드를 돌려볼 수 있도록 이 파일만 깃허브에 공유합니다.
# ==========================================

# Supabase 프로젝트 접속 정보
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# 테스트 계정 (판매자 / 구매자)
SELLER_EMAIL=seller01@example.com
SELLER_PASSWORD=your-seller-password

BUYER_EMAIL=buyer01@example.com
BUYER_PASSWORD=your-buyer-password
