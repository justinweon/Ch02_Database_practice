# ==========================================
# 보안을 위해 GitHub에 절대 올리지 않을 파일 목록
# ==========================================

# 1. 우리 집 비밀번호와 API 키가 들어있는 환경변수 파일
.env
.env.local
.env.*.local

# 2. 파이썬 가상환경 (용량이 너무 커서 깃허브에 올리지 않음)
.venv/
venv/
ENV/

# 3. 파이썬 실행 시 생기는 임시 캐시 파일
__pycache__/
*.py[cod]
*$py.class

# 4. 주피터 노트북 자동 임시 저장소
.ipynb_checkpoints/

# 5. 운영체제 임시 파일
.DS_Store
Thumbs.db
desktop.ini
